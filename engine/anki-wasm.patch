+/// The output of `fut`, polling `background` (which never finishes) alongside it.
+async fn first_of<T>(fut: impl Future<Output = T>, background: impl Future<Output = ()>) -> T {
+    match select(Box::pin(fut), Box::pin(background)).await {
+        Either::Left((out, _)) => out,
+        Either::Right(_) => unreachable!(),
+    }
