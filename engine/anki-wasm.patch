new file mode 100644
index 0000000..ccced34
--- /dev/null
+++ b/rslib/io/src/vfs.rs
@@ -0,0 +1,1223 @@
+// Copyright: Ankitects Pty Ltd and contributors
+// License: GNU AGPL, version 3 or later; http://www.gnu.org/licenses/agpl.html
+
+//! A file system for the browser build, standing in for std::fs (which always
+//! fails on wasm32-unknown-unknown). Anki's code reaches it through
+//! [crate::fs].
+//!
+//! Two stores sit behind it:
+//! - Databases (the collection, the media database) live in a pool of OPFS
+//!   files that SQLite opens itself. The host registers that pool with
+//!   [set_db_pool]; files here can be read, written and renamed into it.
+//! - Every other file (media, temp files, imports and exports) is a row in
+//!   `files.db`, an SQLite database in that same pool.
+//!
+//! Open files share one buffer per path, as an OS would: data written through
+//! one handle is seen by the next open, and by SQLite once
+//! [prepare_for_sqlite] has moved the file into the pool. A buffer is saved
+//! when it is flushed or its last handle is closed.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::fmt;
+use std::io;
+use std::io::Read;
+use std::io::Seek;
+use std::io::SeekFrom;
+use std::io::Write;
+use std::path::Component;
+use std::path::Path;
+use std::path::PathBuf;
+use std::rc::Rc;
+use std::rc::Weak;
+use std::time::Duration;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+use rusqlite::params;
+use rusqlite::Connection;
+use rusqlite::OptionalExtension;
+
+/// Where the database pool keeps `files.db`.
+const FILES_DB: &str = "/files.db";
+const TEMP_DIR: &str = "/tmp";
+
+/// The pool of database files SQLite uses (OPFS sync access handles).
+pub trait DbPool {
+    fn exists(&self, path: &str) -> bool;
+    fn import(&self, path: &str, data: &[u8]) -> io::Result<()>;
+    fn export(&self, path: &str) -> io::Result<Vec<u8>>;
+    fn delete(&self, path: &str) -> io::Result<bool>;
+    /// True if journals must stay in memory (the IndexedDB store only holds
+    /// page-aligned database files).
+    fn memory_journal(&self) -> bool {
+        false
+    }
+}
+
+/// The journal mode to use instead of `wanted`, given the store.
+pub fn journal_mode(wanted: &'static str) -> &'static str {
+    if with_pool(|p| Ok(p.memory_journal())).unwrap_or(false) {
+        "memory"
+    } else {
+        wanted
+    }
+}
+
+thread_local! {
+    static POOL: RefCell<Option<Box<dyn DbPool>>> = const { RefCell::new(None) };
+    static FILES: RefCell<Option<Connection>> = const { RefCell::new(None) };
+    static OPEN: RefCell<HashMap<String, Weak<RefCell<Node>>>> = RefCell::new(HashMap::new());
+}
+
+/// Called once by the host, after it has installed the pool as SQLite's
+/// default VFS.
+pub fn set_db_pool(pool: Box<dyn DbPool>) {
+    POOL.with(|p| *p.borrow_mut() = Some(pool));
+}
+
+fn with_pool<T>(f: impl FnOnce(&dyn DbPool) -> io::Result<T>) -> io::Result<T> {
+    POOL.with(|p| match p.borrow().as_deref() {
+        Some(pool) => f(pool),
+        None => Err(io::Error::other("file storage not ready")),
+    })
+}
+
+fn in_pool(path: &str) -> bool {
+    with_pool(|p| Ok(p.exists(path))).unwrap_or(false)
+}
+
+fn sql_err(err: rusqlite::Error) -> io::Error {
+    io::Error::other(err)
+}
+
+fn with_files<T>(f: impl FnOnce(&Connection) -> rusqlite::Result<T>) -> io::Result<T> {
+    FILES.with(|cell| {
+        let mut cell = cell.borrow_mut();
+        if cell.is_none() {
+            *cell = Some(open_files_db().map_err(sql_err)?);
+        }
+        f(cell.as_ref().unwrap()).map_err(sql_err)
+    })
+}
+
+fn open_files_db() -> rusqlite::Result<Connection> {
+    let db = Connection::open(FILES_DB)?;
+    // One connection, so exclusive locking lets WAL work without shared memory;
+    // NORMAL sync keeps the file consistent and skips a flush per file.
+    db.pragma_update(None, "locking_mode", "exclusive")?;
+    let journal = journal_mode("wal");
+    db.pragma_update(None, "journal_mode", journal)?;
+    db.pragma_update(
+        None,
+        "synchronous",
+        if journal == "memory" { "off" } else { "normal" },
+    )?;
+    db.execute_batch(
+        "create table if not exists entries (
+            path text primary key not null,
+            parent text not null,
+            is_dir integer not null,
+            data blob,
+            size integer not null,
+            mtime integer not null
+        ) without rowid;
+        create index if not exists entries_parent on entries (parent);",
+    )?;
+    Ok(db)
+}
+
+/// Run several file operations as one transaction (much faster for many files).
+pub fn batch<T>(f: impl FnOnce() -> T) -> T {
+    let began = with_files(|db| {
+        if db.is_autocommit() {
+            db.execute_batch("begin")?;
+            Ok(true)
+        } else {
+            Ok(false)
+        }
+    })
+    .unwrap_or(false);
+    let out = f();
+    if began {
+        let _ = with_files(|db| db.execute_batch("commit"));
+    }
+    out
+}
+
+// ---- paths ----------------------------------------------------------------------------
+
+/// Absolute, with `.` and `..` resolved and `/` separators.
+fn key(path: &Path) -> String {
+    let mut parts: Vec<String> = vec![];
+    for comp in path.components() {
+        match comp {
+            Component::Normal(p) => parts.push(p.to_string_lossy().into_owned()),
+            Component::ParentDir => {
+                parts.pop();
+            }
+            Component::CurDir | Component::RootDir | Component::Prefix(_) => {}
+        }
+    }
+    format!("/{}", parts.join("/"))
+}
+
+fn parent_key(key: &str) -> String {
+    match key.rfind('/') {
+        Some(0) | None => "/".into(),
+        Some(i) => key[..i].into(),
+    }
+}
+
+fn name_of(key: &str) -> &str {
+    key.rsplit('/').next().unwrap_or("")
+}
+
+pub fn now_millis() -> i64 {
+    js_sys::Date::now() as i64
+}
+
+/// The current time; std's SystemTime::now() panics in the browser.
+pub fn now() -> SystemTime {
+    UNIX_EPOCH + Duration::from_millis(now_millis() as u64)
+}
+
+fn time_of(millis: i64) -> SystemTime {
+    UNIX_EPOCH + Duration::from_millis(millis.max(0) as u64)
+}
+
+fn millis_of(time: SystemTime) -> i64 {
+    time.duration_since(UNIX_EPOCH)
+        .map(|d| d.as_millis() as i64)
+        .unwrap_or(0)
+}
+
+fn not_found(key: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::NotFound, format!("{key}: not found"))
+}
+
+// ---- stored entries -----------------------------------------------------------------------
+
+struct Stat {
+    is_dir: bool,
+    size: u64,
+    mtime: i64,
+}
+
+fn stored_stat(key: &str) -> io::Result<Option<Stat>> {
+    with_files(|db| {
+        db.query_row(
+            "select is_dir, size, mtime from entries where path = ?",
+            [key],
+            |row| {
+                Ok(Stat {
+                    is_dir: row.get(0)?,
+                    size: row.get(1)?,
+                    mtime: row.get(2)?,
+                })
+            },
+        )
+        .optional()
+    })
+}
+
+fn stored_read(key: &str) -> io::Result<Option<Vec<u8>>> {
+    with_files(|db| {
+        db.query_row(
+            "select data from entries where path = ? and is_dir = 0",
+            [key],
+            |row| row.get::<_, Vec<u8>>(0),
+        )
+        .optional()
+    })
+}
+
+fn ensure_dirs(db: &Connection, dir: &str, mtime: i64) -> rusqlite::Result<()> {
+    let mut dir = dir.to_string();
+    loop {
+        if dir == "/" {
+            return Ok(());
+        }
+        let parent = parent_key(&dir);
+        let added = db.execute(
+            "insert or ignore into entries (path, parent, is_dir, data, size, mtime)
+             values (?, ?, 1, null, 0, ?)",
+            params![dir, parent, mtime],
+        )?;
+        if added == 0 {
+            return Ok(());
+        }
+        dir = parent;
+    }
+}
+
+/// Save a file's contents: into the pool if a database lives at that path,
+/// otherwise into files.db.
+fn store(key: &str, data: &[u8], mtime: i64) -> io::Result<()> {
+    if in_pool(key) {
+        return with_pool(|p| p.import(key, data));
+    }
+    with_files(|db| {
+        ensure_dirs(db, &parent_key(key), mtime)?;
+        db.execute(
+            "insert or replace into entries (path, parent, is_dir, data, size, mtime)
+             values (?, ?, 0, ?, ?, ?)",
+            params![key, parent_key(key), data, data.len() as i64, mtime],
+        )?;
+        Ok(())
+    })
+}
+
+fn unstore(key: &str) -> io::Result<bool> {
+    let removed =
+        with_files(|db| db.execute("delete from entries where path = ? and is_dir = 0", [key]))?;
+    if removed > 0 {
+        return Ok(true);
+    }
+    if in_pool(key) {
+        return with_pool(|p| p.delete(key));
+    }
+    Ok(false)
+}
+
+/// Contents of a file not currently open.
+fn load(key: &str) -> io::Result<Option<Vec<u8>>> {
+    if let Some(data) = stored_read(key)? {
+        return Ok(Some(data));
+    }
+    if in_pool(key) {
+        return with_pool(|p| p.export(key)).map(Some);
+    }
+    Ok(None)
+}
+
+// ---- open files ---------------------------------------------------------------------------
+
+struct Node {
+    key: String,
+    data: Vec<u8>,
+    mtime: i64,
+    dirty: bool,
+    /// Removed while open: not saved again.
+    unlinked: bool,
+    /// A database SQLite has (see prepare_for_sqlite): the pool holds the real
+    /// contents, which SQLite changes behind this handle's back.
+    pooled: bool,
+}
+
+impl Node {
+    /// For a database, the contents as SQLite left them.
+    fn refresh(&mut self) {
+        if self.pooled && !self.dirty && !self.unlinked {
+            if let Ok(data) = with_pool(|p| p.export(&self.key)) {
+                self.data = data;
+            }
+        }
+    }
+
+    fn save(&mut self) -> io::Result<()> {
+        if self.dirty && !self.unlinked {
+            store(&self.key, &self.data, self.mtime)?;
+        }
+        self.dirty = false;
+        Ok(())
+    }
+}
+
+fn open_node(key: &str) -> Option<Rc<RefCell<Node>>> {
+    OPEN.with(|open| open.borrow().get(key).and_then(Weak::upgrade))
+}
+
+fn register_node(node: &Rc<RefCell<Node>>) {
+    let key = node.borrow().key.clone();
+    OPEN.with(|open| {
+        let mut open = open.borrow_mut();
+        open.retain(|_, weak| weak.strong_count() > 0);
+        open.insert(key, Rc::downgrade(node));
+    });
+}
+
+/// Save any unsaved writes to `key`, so the stores see them.
+fn settle(key: &str) -> io::Result<()> {
+    if let Some(node) = open_node(key) {
+        node.borrow_mut().save()?;
+    }
+    Ok(())
+}
+
+/// Before SQLite opens `path`: a file written here (a downloaded or unpacked
+/// collection) moves into the pool, where SQLite can open it.
+pub fn prepare_for_sqlite(path: &Path) -> io::Result<()> {
+    let key = key(path);
+    settle(&key)?;
+    if let Some(data) = stored_read(&key)? {
+        // An empty file (a fresh temp file) is left for SQLite to create.
+        if !data.is_empty() {
+            with_pool(|p| p.import(&key, &data))?;
+        }
+        with_files(|db| db.execute("delete from entries where path = ?", [&key]))?;
+    }
+    // Handles open on it now read what SQLite writes.
+    if let Some(node) = open_node(&key) {
+        let mut n = node.borrow_mut();
+        n.pooled = true;
+        n.dirty = false;
+    }
+    Ok(())
+}
+
+// ---- std::fs's API ------------------------------------------------------------------------
+
+#[derive(Clone, Debug, Default)]
+pub struct OpenOptions {
+    read: bool,
+    write: bool,
+    append: bool,
+    truncate: bool,
+    create: bool,
+    create_new: bool,
+}
+
+impl OpenOptions {
+    pub fn new() -> Self {
+        Self::default()
+    }
+    pub fn read(&mut self, v: bool) -> &mut Self {
+        self.read = v;
+        self
+    }
+    pub fn write(&mut self, v: bool) -> &mut Self {
+        self.write = v;
+        self
+    }
+    pub fn append(&mut self, v: bool) -> &mut Self {
+        self.append = v;
+        self
+    }
+    pub fn truncate(&mut self, v: bool) -> &mut Self {
+        self.truncate = v;
+        self
+    }
+    pub fn create(&mut self, v: bool) -> &mut Self {
+        self.create = v;
+        self
+    }
+    pub fn create_new(&mut self, v: bool) -> &mut Self {
+        self.create_new = v;
+        self
+    }
+
+    pub fn open<P: AsRef<Path>>(&self, path: P) -> io::Result<File> {
+        let key = key(path.as_ref());
+        let writable = self.write || self.append;
+        let node = match open_node(&key) {
+            Some(node) => {
+                if self.create_new {
+                    return Err(io::Error::new(io::ErrorKind::AlreadyExists, key));
+                }
+                node
+            }
+            None => {
+                let existing = load(&key)?;
+                if let Some(stat) = stored_stat(&key)? {
+                    if stat.is_dir {
+                        return Err(io::Error::new(io::ErrorKind::IsADirectory, key));
+                    }
+                }
+                let (data, mtime, dirty) = match existing {
+                    Some(_) if self.create_new => {
+                        return Err(io::Error::new(io::ErrorKind::AlreadyExists, key));
+                    }
+                    Some(data) => {
+                        let mtime = stored_stat(&key)?
+                            .map(|s| s.mtime)
+                            .unwrap_or_else(now_millis);
+                        (data, mtime, false)
+                    }
+                    None if writable && (self.create || self.create_new) => {
+                        (vec![], now_millis(), true)
+                    }
+                    None => return Err(not_found(&key)),
+                };
+                let pooled = in_pool(&key) && stored_stat(&key)?.is_none();
+                let node = Rc::new(RefCell::new(Node {
+                    key,
+                    data,
+                    mtime,
+                    dirty,
+                    unlinked: false,
+                    pooled,
+                }));
+                register_node(&node);
+                node
+            }
+        };
+        if writable && self.truncate && !self.append {
+            let mut n = node.borrow_mut();
+            n.data.clear();
+            n.dirty = true;
+            n.mtime = now_millis();
+        }
+        Ok(File {
+            node,
+            pos: std::cell::Cell::new(0),
+            read: self.read || !writable,
+            write: writable,
+            append: self.append,
+        })
+    }
+}
+
+pub struct File {
+    node: Rc<RefCell<Node>>,
+    pos: std::cell::Cell<u64>,
+    read: bool,
+    write: bool,
+    append: bool,
+}
+
+impl fmt::Debug for File {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "File({})", self.node.borrow().key)
+    }
+}
+
+impl File {
+    pub fn open<P: AsRef<Path>>(path: P) -> io::Result<File> {
+        OpenOptions::new().read(true).open(path)
+    }
+
+    pub fn create<P: AsRef<Path>>(path: P) -> io::Result<File> {
+        OpenOptions::new()
+            .write(true)
+            .create(true)
+            .truncate(true)
+            .open(path)
+    }
+
+    pub fn create_new<P: AsRef<Path>>(path: P) -> io::Result<File> {
+        OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .open(path)
+    }
+
+    pub fn options() -> OpenOptions {
+        OpenOptions::new()
+    }
+
+    pub fn metadata(&self) -> io::Result<Metadata> {
+        self.node.borrow_mut().refresh();
+        let n = self.node.borrow();
+        Ok(Metadata {
+            is_dir: false,
+            len: n.data.len() as u64,
+            mtime: n.mtime,
+        })
+    }
+
+    pub fn sync_all(&self) -> io::Result<()> {
+        self.node.borrow_mut().save()
+    }
+
+    pub fn sync_data(&self) -> io::Result<()> {
+        self.sync_all()
+    }
+
+    pub fn set_len(&self, size: u64) -> io::Result<()> {
+        let mut n = self.node.borrow_mut();
+        n.data.resize(size as usize, 0);
+        n.dirty = true;
+        n.mtime = now_millis();
+        Ok(())
+    }
+
+    pub fn set_times(&self, times: FileTimes) -> io::Result<()> {
+        if let Some(modified) = times.modified {
+            let mut n = self.node.borrow_mut();
+            n.mtime = millis_of(modified);
+            n.dirty = true;
+            n.save()?;
+        }
+        Ok(())
+    }
+
+    pub fn set_modified(&self, time: SystemTime) -> io::Result<()> {
+        self.set_times(FileTimes::new().set_modified(time))
+    }
+
+    pub fn try_clone(&self) -> io::Result<File> {
+        Ok(File {
+            node: self.node.clone(),
+            pos: std::cell::Cell::new(self.pos.get()),
+            read: self.read,
+            write: self.write,
+            append: self.append,
+        })
+    }
+
+    fn read_at_pos(&self, buf: &mut [u8]) -> io::Result<usize> {
+        if !self.read {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "not open for reading",
+            ));
+        }
+        if self.pos.get() == 0 {
+            self.node.borrow_mut().refresh();
+        }
+        let n = self.node.borrow();
+        let start = (self.pos.get() as usize).min(n.data.len());
+        let count = buf.len().min(n.data.len() - start);
+        buf[..count].copy_from_slice(&n.data[start..start + count]);
+        drop(n);
+        self.pos.set((start + count) as u64);
+        Ok(count)
+    }
+
+    fn write_at_pos(&self, buf: &[u8]) -> io::Result<usize> {
+        if !self.write {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "not open for writing",
+            ));
+        }
+        let mut n = self.node.borrow_mut();
+        if self.append {
+            self.pos.set(n.data.len() as u64);
+        }
+        let start = self.pos.get() as usize;
+        let end = start + buf.len();
+        if n.data.len() < end {
+            n.data.resize(end, 0);
+        }
+        n.data[start..end].copy_from_slice(buf);
+        n.dirty = true;
+        n.mtime = now_millis();
+        drop(n);
+        self.pos.set(end as u64);
+        Ok(buf.len())
+    }
+
+    fn seek_to(&self, pos: SeekFrom) -> io::Result<u64> {
+        if matches!(pos, SeekFrom::End(_)) {
+            self.node.borrow_mut().refresh();
+        }
+        let len = self.node.borrow().data.len() as i64;
+        let new = match pos {
+            SeekFrom::Start(p) => p as i64,
+            SeekFrom::End(off) => len + off,
+            SeekFrom::Current(off) => self.pos.get() as i64 + off,
+        };
+        if new < 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "seek before start",
+            ));
+        }
+        self.pos.set(new as u64);
+        Ok(new as u64)
+    }
+}
+
+impl Drop for File {
+    fn drop(&mut self) {
+        // the last handle saves
+        if Rc::strong_count(&self.node) == 1 {
+            let _ = self.node.borrow_mut().save();
+        }
+    }
+}
+
+impl Read for File {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        self.read_at_pos(buf)
+    }
+}
+
+impl Read for &File {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        self.read_at_pos(buf)
+    }
+}
+
+impl Write for &File {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        self.write_at_pos(buf)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+impl Seek for &File {
+    fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> {
+        self.seek_to(pos)
+    }
+}
+
+impl Write for File {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        self.write_at_pos(buf)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+impl Seek for File {
+    fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> {
+        self.seek_to(pos)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct FileTimes {
+    modified: Option<SystemTime>,
+}
+
+impl FileTimes {
+    pub fn new() -> Self {
+        Self::default()
+    }
+    pub fn set_accessed(self, _t: SystemTime) -> Self {
+        self
+    }
+    pub fn set_modified(mut self, t: SystemTime) -> Self {
+        self.modified = Some(t);
+        self
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct FileType {
+    is_dir: bool,
+}
+
+impl FileType {
+    pub fn is_dir(&self) -> bool {
+        self.is_dir
+    }
+    pub fn is_file(&self) -> bool {
+        !self.is_dir
+    }
+    pub fn is_symlink(&self) -> bool {
+        false
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct Metadata {
+    is_dir: bool,
+    len: u64,
+    mtime: i64,
+}
+
+impl Metadata {
+    pub fn len(&self) -> u64 {
+        self.len
+    }
+    pub fn is_empty(&self) -> bool {
+        self.len == 0
+    }
+    pub fn is_dir(&self) -> bool {
+        self.is_dir
+    }
+    pub fn is_file(&self) -> bool {
+        !self.is_dir
+    }
+    pub fn is_symlink(&self) -> bool {
+        false
+    }
+    pub fn file_type(&self) -> FileType {
+        FileType {
+            is_dir: self.is_dir,
+        }
+    }
+    pub fn modified(&self) -> io::Result<SystemTime> {
+        Ok(time_of(self.mtime))
+    }
+    pub fn accessed(&self) -> io::Result<SystemTime> {
+        self.modified()
+    }
+    pub fn created(&self) -> io::Result<SystemTime> {
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "no creation time",
+        ))
+    }
+}
+
+pub fn metadata<P: AsRef<Path>>(path: P) -> io::Result<Metadata> {
+    let key = key(path.as_ref());
+    if key == "/" {
+        return Ok(Metadata {
+            is_dir: true,
+            len: 0,
+            mtime: 0,
+        });
+    }
+    if let Some(node) = open_node(&key) {
+        node.borrow_mut().refresh();
+        let n = node.borrow();
+        if !n.unlinked {
+            return Ok(Metadata {
+                is_dir: false,
+                len: n.data.len() as u64,
+                mtime: n.mtime,
+            });
+        }
+    }
+    if let Some(stat) = stored_stat(&key)? {
+        return Ok(Metadata {
+            is_dir: stat.is_dir,
+            len: stat.size,
+            mtime: stat.mtime,
+        });
+    }
+    if in_pool(&key) {
+        let len = with_pool(|p| p.export(&key))?.len() as u64;
+        return Ok(Metadata {
+            is_dir: false,
+            len,
+            mtime: now_millis(),
+        });
+    }
+    Err(not_found(&key))
+}
+
+pub fn symlink_metadata<P: AsRef<Path>>(path: P) -> io::Result<Metadata> {
+    metadata(path)
+}
+
+pub fn exists<P: AsRef<Path>>(path: P) -> io::Result<bool> {
+    match metadata(path) {
+        Ok(_) => Ok(true),
+        Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(e) => Err(e),
+    }
+}
+
+pub fn read<P: AsRef<Path>>(path: P) -> io::Result<Vec<u8>> {
+    let key = key(path.as_ref());
+    if let Some(node) = open_node(&key) {
+        node.borrow_mut().refresh();
+        let n = node.borrow();
+        if !n.unlinked {
+            return Ok(n.data.clone());
+        }
+    }
+    load(&key)?.ok_or_else(|| not_found(&key))
+}
+
+pub fn read_to_string<P: AsRef<Path>>(path: P) -> io::Result<String> {
+    String::from_utf8(read(path)?).map_err(|e| io::Error::new(io::ErrorKind::InvalidData, e))
+}
+
+pub fn write<P: AsRef<Path>, C: AsRef<[u8]>>(path: P, contents: C) -> io::Result<()> {
+    let key = key(path.as_ref());
+    let contents = contents.as_ref();
+    if let Some(node) = open_node(&key) {
+        let mut n = node.borrow_mut();
+        n.data = contents.to_vec();
+        n.mtime = now_millis();
+        n.dirty = true;
+        n.unlinked = false;
+        return n.save();
+    }
+    store(&key, contents, now_millis())
+}
+
+pub fn remove_file<P: AsRef<Path>>(path: P) -> io::Result<()> {
+    let key = key(path.as_ref());
+    let was_open = match open_node(&key) {
+        Some(node) => {
+            let mut n = node.borrow_mut();
+            let unsaved = n.dirty && !n.unlinked;
+            n.unlinked = true;
+            unsaved
+        }
+        None => false,
+    };
+    if unstore(&key)? || was_open {
+        Ok(())
+    } else {
+        Err(not_found(&key))
+    }
+}
+
+pub fn rename<P: AsRef<Path>, Q: AsRef<Path>>(from: P, to: Q) -> io::Result<()> {
+    let from = key(from.as_ref());
+    let to = key(to.as_ref());
+    if from == to {
+        return Ok(());
+    }
+    settle(&from)?;
+    let stat = stored_stat(&from)?;
+    if stat.as_ref().is_some_and(|s| s.is_dir) {
+        return rename_dir(&from, &to);
+    }
+    let data = load(&from)?.ok_or_else(|| not_found(&from))?;
+    let mtime = stat.map(|s| s.mtime).unwrap_or_else(now_millis);
+    // whatever was open at the target is replaced
+    if let Some(node) = open_node(&to) {
+        node.borrow_mut().unlinked = true;
+    }
+    if !in_pool(&to) {
+        let _ = with_files(|db| db.execute("delete from entries where path = ?", [&to]));
+    }
+    store(&to, &data, mtime)?;
+    unstore(&from)?;
+    // handles open on the old name now refer to the new one
+    if let Some(node) = open_node(&from) {
+        node.borrow_mut().key = to.clone();
+        register_node(&node);
+        OPEN.with(|open| open.borrow_mut().remove(&from));
+    }
+    Ok(())
+}
+
+fn rename_dir(from: &str, to: &str) -> io::Result<()> {
+    with_files(|db| {
+        let prefix = format!("{from}/");
+        let rows: Vec<String> = db
+            .prepare("select path from entries where path = ? or substr(path, 1, ?) = ?")?
+            .query_map(params![from, prefix.len() as i64, prefix], |r| r.get(0))?
+            .collect::<rusqlite::Result<_>>()?;
+        for old in rows {
+            let new = format!("{to}{}", &old[from.len()..]);
+            db.execute(
+                "update entries set path = ?, parent = ? where path = ?",
+                params![new, parent_key(&new), old],
+            )?;
+        }
+        ensure_dirs(db, &parent_key(to), now_millis())
+    })
+}
+
+pub fn copy<P: AsRef<Path>, Q: AsRef<Path>>(from: P, to: Q) -> io::Result<u64> {
+    let data = read(from)?;
+    write(to, &data)?;
+    Ok(data.len() as u64)
+}
+
+pub fn create_dir<P: AsRef<Path>>(path: P) -> io::Result<()> {
+    let key = key(path.as_ref());
+    if exists(&key)? {
+        return Err(io::Error::new(io::ErrorKind::AlreadyExists, key));
+    }
+    create_dir_all(&key)
+}
+
+pub fn create_dir_all<P: AsRef<Path>>(path: P) -> io::Result<()> {
+    let key = key(path.as_ref());
+    with_files(|db| ensure_dirs(db, &key, now_millis()))
+}
+
+pub fn remove_dir<P: AsRef<Path>>(path: P) -> io::Result<()> {
+    let key = key(path.as_ref());
+    let children: i64 = with_files(|db| {
+        db.query_row(
+            "select count(*) from entries where parent = ?",
+            [&key],
+            |r| r.get(0),
+        )
+    })?;
+    if children > 0 {
+        return Err(io::Error::new(io::ErrorKind::DirectoryNotEmpty, key));
+    }
+    with_files(|db| db.execute("delete from entries where path = ? and is_dir = 1", [&key]))?;
+    Ok(())
+}
+
+pub fn remove_dir_all<P: AsRef<Path>>(path: P) -> io::Result<()> {
+    let key = key(path.as_ref());
+    let prefix = format!("{key}/");
+    with_files(|db| {
+        db.execute(
+            "delete from entries where path = ? or substr(path, 1, ?) = ?",
+            params![key, prefix.len() as i64, prefix],
+        )
+    })?;
+    Ok(())
+}
+
+pub fn canonicalize<P: AsRef<Path>>(path: P) -> io::Result<PathBuf> {
+    Ok(PathBuf::from(key(path.as_ref())))
+}
+
+pub struct DirEntry {
+    key: String,
+    meta: Metadata,
+}
+
+impl DirEntry {
+    pub fn path(&self) -> PathBuf {
+        PathBuf::from(&self.key)
+    }
+    pub fn file_name(&self) -> std::ffi::OsString {
+        name_of(&self.key).into()
+    }
+    pub fn metadata(&self) -> io::Result<Metadata> {
+        Ok(self.meta.clone())
+    }
+    pub fn file_type(&self) -> io::Result<FileType> {
+        Ok(self.meta.file_type())
+    }
+}
+
+impl fmt::Debug for DirEntry {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "DirEntry({})", self.key)
+    }
+}
+
+pub struct ReadDir(std::vec::IntoIter<DirEntry>);
+
+impl Iterator for ReadDir {
+    type Item = io::Result<DirEntry>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        self.0.next().map(Ok)
+    }
+}
+
+pub fn read_dir<P: AsRef<Path>>(path: P) -> io::Result<ReadDir> {
+    let key = key(path.as_ref());
+    match metadata(&key) {
+        Ok(meta) if !meta.is_dir() => {
+            return Err(io::Error::new(io::ErrorKind::NotADirectory, key))
+        }
+        Err(e) => return Err(e),
+        _ => {}
+    }
+    // unsaved files show up too
+    OPEN.with(|open| {
+        for weak in open.borrow().values() {
+            if let Some(node) = weak.upgrade() {
+                let _ = node.borrow_mut().save();
+            }
+        }
+    });
+    let entries = with_files(|db| {
+        db.prepare(
+            "select path, is_dir, size, mtime from entries where parent = ? and path != '/'",
+        )?
+        .query_map([&key], |row| {
+            Ok(DirEntry {
+                key: row.get(0)?,
+                meta: Metadata {
+                    is_dir: row.get(1)?,
+                    len: row.get(2)?,
+                    mtime: row.get(3)?,
+                },
+            })
+        })?
+        .collect::<rusqlite::Result<Vec<_>>>()
+    })?;
+    Ok(ReadDir(entries.into_iter()))
+}
+
+// ---- tempfile's API -----------------------------------------------------------------------
+
+fn unique_name(dir: &str, prefix: &str) -> String {
+    let rand: u64 = rand::random();
+    let base = if dir == "/" { "" } else { dir };
+    format!("{base}/{prefix}{rand:016x}")
+}
+
+pub struct NamedTempFile {
+    path: Option<PathBuf>,
+    file: File,
+}
+
+impl fmt::Debug for NamedTempFile {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "NamedTempFile({:?})", self.path)
+    }
+}
+
+impl NamedTempFile {
+    pub fn new() -> io::Result<Self> {
+        Self::new_in(TEMP_DIR)
+    }
+
+    pub fn new_in<P: AsRef<Path>>(dir: P) -> io::Result<Self> {
+        let dir = key(dir.as_ref());
+        create_dir_all(&dir)?;
+        let path = PathBuf::from(unique_name(&dir, ".tmp"));
+        let file = File::create_new(&path)?;
+        Ok(Self {
+            path: Some(path),
+            file,
+        })
+    }
+
+    pub fn path(&self) -> &Path {
+        self.path.as_deref().unwrap()
+    }
+
+    pub fn as_file(&self) -> &File {
+        &self.file
+    }
+
+    pub fn as_file_mut(&mut self) -> &mut File {
+        &mut self.file
+    }
+
+    pub fn reopen(&self) -> io::Result<File> {
+        File::open(self.path())
+    }
+
+    pub fn persist<P: AsRef<Path>>(mut self, new_path: P) -> Result<File, PersistError> {
+        let path = self.path.take().unwrap();
+        match rename(&path, new_path.as_ref()) {
+            Ok(()) => {
+                let file = self.file.try_clone().expect("clone");
+                Ok(file)
+            }
+            Err(error) => {
+                self.path = Some(path);
+                Err(PersistError { error, file: self })
+            }
+        }
+    }
+
+    pub fn keep(mut self) -> Result<(File, PathBuf), PersistError> {
+        let path = self.path.take().unwrap();
+        Ok((self.file.try_clone().expect("clone"), path))
+    }
+
+    pub fn into_temp_path(mut self) -> TempPath {
+        TempPath {
+            path: self.path.take(),
+        }
+    }
+}
+
+impl Drop for NamedTempFile {
+    fn drop(&mut self) {
+        if let Some(path) = &self.path {
+            let _ = remove_file(path);
+        }
+    }
+}
+
+impl Read for NamedTempFile {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        self.file.read(buf)
+    }
+}
+
+impl Write for NamedTempFile {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        self.file.write(buf)
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        self.file.flush()
+    }
+}
+
+impl Seek for NamedTempFile {
+    fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> {
+        self.file.seek(pos)
+    }
+}
+
+pub struct TempPath {
+    path: Option<PathBuf>,
+}
+
+impl std::ops::Deref for TempPath {
+    type Target = Path;
+    fn deref(&self) -> &Path {
+        self.path.as_deref().unwrap()
+    }
+}
+
+impl AsRef<Path> for TempPath {
+    fn as_ref(&self) -> &Path {
+        self
+    }
+}
+
+impl TempPath {
+    pub fn persist<P: AsRef<Path>>(mut self, new_path: P) -> Result<(), PathPersistError> {
+        let path = self.path.take().unwrap();
+        rename(&path, new_path.as_ref()).map_err(|error| PathPersistError {
+            error,
+            path: TempPath { path: Some(path) },
+        })
+    }
+}
+
+impl Drop for TempPath {
+    fn drop(&mut self) {
+        if let Some(path) = &self.path {
+            let _ = remove_file(path);
+        }
+    }
+}
+
+pub struct TempDir {
+    path: Option<PathBuf>,
+}
+
+impl TempDir {
+    pub fn new() -> io::Result<Self> {
+        let path = PathBuf::from(unique_name(TEMP_DIR, ".tmpdir"));
+        create_dir_all(&path)?;
+        Ok(Self { path: Some(path) })
+    }
+    pub fn path(&self) -> &Path {
+        self.path.as_deref().unwrap()
+    }
+}
+
+impl Drop for TempDir {
+    fn drop(&mut self) {
+        if let Some(path) = &self.path {
+            let _ = remove_dir_all(path);
+        }
+    }
+}
+
+pub fn tempdir() -> io::Result<TempDir> {
+    TempDir::new()
+}
+
+#[derive(Debug)]
+pub struct PersistError {
+    pub error: io::Error,
+    pub file: NamedTempFile,
+}
+
+impl fmt::Display for PersistError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "failed to persist temporary file: {}", self.error)
+    }
+}
+
+impl std::error::Error for PersistError {}
+
+pub struct PathPersistError {
+    pub error: io::Error,
+    pub path: TempPath,
+}
+
+impl fmt::Debug for PathPersistError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "PathPersistError({})", self.error)
+    }
+}
+
+impl fmt::Display for PathPersistError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "failed to persist temporary file path: {}", self.error)
+    }
+}
+
+impl std::error::Error for PathPersistError {}
