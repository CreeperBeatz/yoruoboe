diff --git a/rslib/wasm/src/lib.rs b/rslib/wasm/src/lib.rs
new file mode 100644
index 0000000..0ec1cbb
--- /dev/null
+++ b/rslib/wasm/src/lib.rs
@@ -0,0 +1,288 @@
+// Copyright: Ankitects Pty Ltd and contributors
+// License: GNU AGPL, version 3 or later; http://www.gnu.org/licenses/agpl.html
+
+//! Anki's backend for the browser, as rsbridge is for Python: the app calls
+//! backend methods by (service, method) number with protobuf bytes. It runs in a
+//! dedicated worker, where OPFS allows synchronous file access.
+//!
+//! Sync methods need the network, which the browser only offers
+//! asynchronously; they have their own async entry points. While one runs,
+//! the caller must not make other collection calls (the collection is held
+//! for the whole sync), except progress, abort and media sync status.
+
+use std::io;
+
+use anki::backend::init_backend;
+use anki::backend::Backend;
+use anki_io::vfs::DbPool;
+use prost::Message;
+use sqlite_wasm_vfs::relaxed_idb::Preload;
+use sqlite_wasm_vfs::relaxed_idb::RelaxedIdbCfgBuilder;
+use sqlite_wasm_vfs::relaxed_idb::RelaxedIdbUtil;
+use sqlite_wasm_vfs::sahpool::OpfsSAHPoolCfgBuilder;
+use sqlite_wasm_vfs::sahpool::OpfsSAHPoolUtil;
+use wasm_bindgen::prelude::*;
+
+struct Pool(OpfsSAHPoolUtil);
+
+fn pool_err(err: impl std::fmt::Display) -> io::Error {
+    io::Error::other(err.to_string())
+}
+
+impl DbPool for Pool {
+    fn exists(&self, path: &str) -> bool {
+        self.0.exists(path).unwrap_or(false)
+    }
+    fn import(&self, path: &str, data: &[u8]) -> io::Result<()> {
+        // the pool won't import over an existing file
+        if self.0.exists(path).unwrap_or(false) {
+            self.0.delete_db(path).map_err(pool_err)?;
+        }
+        self.0.import_db_unchecked(path, data).map_err(pool_err)
+    }
+    fn export(&self, path: &str) -> io::Result<Vec<u8>> {
+        self.0.export_db(path).map_err(pool_err)
+    }
+    fn delete(&self, path: &str) -> io::Result<bool> {
+        self.0.delete_db(path).map_err(pool_err)
+    }
+}
+
+/// The fallback store: IndexedDB, with databases held in memory and written
+/// back in the background. For browsers without OPFS sync access handles.
+struct IdbPool(RelaxedIdbUtil);
+
+impl DbPool for IdbPool {
+    fn exists(&self, path: &str) -> bool {
+        self.0.exists(path)
+    }
+    fn import(&self, path: &str, data: &[u8]) -> io::Result<()> {
+        if self.0.exists(path) {
+            drop(self.0.delete_db(path).map_err(pool_err)?);
+        }
+        // SQLite's page size, from the header (1 means 65536)
+        let page_size = match data.get(16..18) {
+            Some(&[1, 0]) => 65536,
+            Some(&[hi, lo]) => (hi as usize) * 256 + lo as usize,
+            _ => 4096,
+        };
+        drop(
+            self.0
+                .import_db_unchecked(path, data, page_size)
+                .map_err(pool_err)?,
+        );
+        Ok(())
+    }
+    fn export(&self, path: &str) -> io::Result<Vec<u8>> {
+        self.0.export_db(path).map_err(pool_err)
+    }
+    fn delete(&self, path: &str) -> io::Result<bool> {
+        let existed = self.0.exists(path);
+        if existed {
+            drop(self.0.delete_db(path).map_err(pool_err)?);
+        }
+        Ok(existed)
+    }
+    fn memory_journal(&self) -> bool {
+        true
+    }
+}
+
+async fn install_opfs(directory: &str) -> Result<Box<dyn DbPool>, String> {
+    let cfg = OpfsSAHPoolCfgBuilder::new()
+        .vfs_name("anki-opfs")
+        .directory(directory)
+        .initial_capacity(24)
+        .build();
+    let util = sqlite_wasm_vfs::sahpool::install::<sqlite_wasm_rs::WasmOsCallback>(&cfg, true)
+        .await
+        .map_err(|e| e.to_string())?;
+    // a collection and its WAL, the media database and its journal, files.db
+    // and its WAL, and room for imports
+    util.reserve_minimum_capacity(24)
+        .await
+        .map_err(|e| e.to_string())?;
+    Ok(Box::new(Pool(util)))
+}
+
+async fn install_idb(directory: &str) -> Result<Box<dyn DbPool>, String> {
+    let cfg = RelaxedIdbCfgBuilder::new()
+        .vfs_name(directory)
+        .preload(Preload::All)
+        .build();
+    let util = sqlite_wasm_vfs::relaxed_idb::install::<sqlite_wasm_rs::WasmOsCallback>(&cfg, true)
+        .await
+        .map_err(|e| e.to_string())?;
+    Ok(Box::new(IdbPool(util)))
+}
+
+/// Set up storage for Anki's databases and files, kept under `directory`
+/// (an OPFS folder, or an IndexedDB database). `mode` is "opfs", "idb", or
+/// "auto" (OPFS if the browser supports it). Resolves with the store used.
+/// Call once per worker, before anything else.
+#[wasm_bindgen(js_name = initStorage)]
+pub async fn init_storage(directory: String, mode: String) -> Result<String, JsValue> {
+    console_error_panic_hook::set_once();
+    let (pool, used) = match mode.as_str() {
+        "idb" => (install_idb(&directory).await, "idb"),
+        "opfs" => (install_opfs(&directory).await, "opfs"),
+        _ => match install_opfs(&directory).await {
+            Ok(pool) => (Ok(pool), "opfs"),
+            Err(_) => (install_idb(&directory).await, "idb"),
+        },
+    };
+    let pool = pool.map_err(|e| JsValue::from_str(&format!("storage ({used}): {e}")))?;
+    anki_io::vfs::set_db_pool(pool);
+    Ok(used.into())
+}
+
+#[wasm_bindgen(js_name = buildHash)]
+pub fn build_hash() -> String {
+    anki::version::buildhash().into()
+}
+
+#[wasm_bindgen]
+pub struct Engine {
+    backend: Backend,
+}
+
+fn error_bytes(backend: &Backend, err: anki::error::AnkiError) -> JsValue {
+    let bytes = err.into_protobuf(backend.i18n()).encode_to_vec();
+    js_sys::Uint8Array::from(&bytes[..]).into()
+}
+
+fn decode<T: Message + Default>(backend: &Backend, input: &[u8]) -> Result<T, JsValue> {
+    T::decode(input).map_err(|e| error_bytes(backend, e.into()))
+}
+
+fn bytes(data: &[u8]) -> JsValue {
+    js_sys::Uint8Array::from(data).into()
+}
+
+#[wasm_bindgen]
+impl Engine {
+    /// `init` is an encoded BackendInit.
+    #[wasm_bindgen(constructor)]
+    pub fn new(init: &[u8]) -> Result<Engine, JsValue> {
+        let backend = init_backend(init).map_err(|e| JsValue::from_str(&e))?;
+        Ok(Engine { backend })
+    }
+
+    /// Run a backend method. Fails with an encoded BackendError.
+    pub fn command(&self, service: u32, method: u32, input: &[u8]) -> Result<Vec<u8>, JsValue> {
+        self.backend
+            .run_service_method(service, method, input)
+            .map_err(|err| bytes(&err))
+    }
+
+    /// DB proxy commands (JSON in and out), as pylib's db_command.
+    #[wasm_bindgen(js_name = dbCommand)]
+    pub fn db_command(&self, input: &[u8]) -> Result<Vec<u8>, JsValue> {
+        self.backend
+            .run_db_command_bytes(input)
+            .map_err(|err| bytes(&err))
+    }
+
+    #[wasm_bindgen(js_name = syncLogin)]
+    pub fn sync_login(&self, input: Vec<u8>) -> js_sys::Promise {
+        let backend = self.backend.clone();
+        wasm_bindgen_futures::future_to_promise(async move {
+            let req = decode(&backend, &input)?;
+            match backend.sync_login_async(req).await {
+                Ok(out) => Ok(bytes(&out.encode_to_vec())),
+                Err(err) => Err(error_bytes(&backend, err)),
+            }
+        })
+    }
+
+    #[wasm_bindgen(js_name = syncStatus)]
+    pub fn sync_status(&self, input: Vec<u8>) -> js_sys::Promise {
+        let backend = self.backend.clone();
+        wasm_bindgen_futures::future_to_promise(async move {
+            let req = decode(&backend, &input)?;
+            match backend.sync_status_async(req).await {
+                Ok(out) => Ok(bytes(&out.encode_to_vec())),
+                Err(err) => Err(error_bytes(&backend, err)),
+            }
+        })
+    }
+
+    #[wasm_bindgen(js_name = syncCollection)]
+    pub fn sync_collection(&self, input: Vec<u8>) -> js_sys::Promise {
+        let backend = self.backend.clone();
+        wasm_bindgen_futures::future_to_promise(async move {
+            let req = decode(&backend, &input)?;
+            match backend.sync_collection_async(req).await {
+                Ok(out) => Ok(bytes(&out.encode_to_vec())),
+                Err(err) => Err(error_bytes(&backend, err)),
+            }
+        })
+    }
+
+    #[wasm_bindgen(js_name = fullUploadOrDownload)]
+    pub fn full_upload_or_download(&self, input: Vec<u8>) -> js_sys::Promise {
+        let backend = self.backend.clone();
+        wasm_bindgen_futures::future_to_promise(async move {
+            let req = decode(&backend, &input)?;
+            match backend.full_upload_or_download_async(req).await {
+                Ok(()) => Ok(bytes(&[])),
+                Err(err) => Err(error_bytes(&backend, err)),
+            }
+        })
+    }
+}
+
+// ---- files, for the app: media to show, packages to import, exports to save ----
+
+fn io_err(err: io::Error) -> JsValue {
+    JsValue::from_str(&err.to_string())
+}
+
+/// A file's contents, or undefined if it doesn't exist.
+#[wasm_bindgen(js_name = readFile)]
+pub fn read_file(path: &str) -> Result<Option<Vec<u8>>, JsValue> {
+    match anki_io::fs::read(path) {
+        Ok(data) => Ok(Some(data)),
+        Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(None),
+        Err(e) => Err(io_err(e)),
+    }
+}
+
+#[wasm_bindgen(js_name = writeFile)]
+pub fn write_file(path: &str, data: &[u8]) -> Result<(), JsValue> {
+    anki_io::fs::write(path, data).map_err(io_err)
+}
+
+#[wasm_bindgen(js_name = removeFile)]
+pub fn remove_file(path: &str) -> Result<(), JsValue> {
+    match anki_io::fs::remove_file(path) {
+        Err(e) if e.kind() != io::ErrorKind::NotFound => Err(io_err(e)),
+        _ => Ok(()),
+    }
+}
+
+/// [size, modified ms] of a file, or undefined.
+#[wasm_bindgen(js_name = statFile)]
+pub fn stat_file(path: &str) -> Option<Vec<f64>> {
+    let meta = anki_io::fs::metadata(path).ok()?;
+    let mtime = meta
+        .modified()
+        .ok()?
+        .duration_since(std::time::UNIX_EPOCH)
+        .ok()?
+        .as_millis() as f64;
+    Some(vec![meta.len() as f64, mtime])
+}
+
+/// Names of the files in a folder.
+#[wasm_bindgen(js_name = listDir)]
+pub fn list_dir(path: &str) -> Result<Vec<String>, JsValue> {
+    let mut names = vec![];
+    for entry in anki_io::fs::read_dir(path).map_err(io_err)? {
+        let entry = entry.map_err(io_err)?;
+        if entry.file_type().map_err(io_err)?.is_file() {
+            names.push(entry.file_name().to_string_lossy().into_owned());
+        }
+    }
+    Ok(names)
+}
