+//! everywhere), and the stall timeout runs on setTimeout.
+
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Duration;
+
+use futures::future::select;
+use futures::future::Either;
+use futures::StreamExt;
+use reqwest::header::CONTENT_LENGTH;
+use reqwest::header::CONTENT_TYPE;
+use reqwest::RequestBuilder;
+use reqwest::StatusCode;
+use web_time::Instant;
+
+use crate::sync::error::HttpError;
+use crate::sync::error::HttpResult;
+use crate::sync::error::OrHttpErr;
+use crate::sync::response::ORIGINAL_SIZE;
+use crate::wasm::sleep;
+use crate::wasm::AssertSend;
+
+#[derive(Clone)]
+pub struct IoMonitor(pub Arc<Mutex<IoMonitorInner>>);
+
+impl IoMonitor {
+    pub fn new() -> Self {
+        Self(Arc::new(Mutex::new(IoMonitorInner {
+            last_activity: Instant::now(),
+            bytes_sent: 0,
+            total_bytes_to_send: 0,
+            bytes_received: 0,
+            total_bytes_to_receive: 0,
+        })))
+    }
+
+    fn touch(&self, f: impl FnOnce(&mut IoMonitorInner)) {
+        let mut inner = self.0.lock().unwrap();
+        inner.last_activity = Instant::now();
+        f(&mut inner);
+    }
+
+    /// Returns if no I/O activity observed for `stall_time`.
+    pub async fn timeout(&self, stall_time: Duration) {
+        loop {
+            sleep(Duration::from_millis(1000)).await;
+            let last_activity = self.0.lock().unwrap().last_activity;
+            if last_activity.elapsed() > stall_time {
+                return;
+            }
+        }
+    }
+
+    /// Takes care of encoding provided request data and setting content type to
+    /// binary, and returns the decompressed response body.
+    pub async fn zstd_request_with_timeout(
+        &self,
+        request: RequestBuilder,
+        request_body: Vec<u8>,
+        stall_duration: Duration,
+    ) -> HttpResult<Vec<u8>> {
+        AssertSend(self.request_inner(request, request_body, stall_duration)).await
+    }
+
+    async fn request_inner(
+        &self,
+        request: RequestBuilder,
+        request_body: Vec<u8>,
+        stall_duration: Duration,
+    ) -> HttpResult<Vec<u8>> {
+        let request_total = request_body.len() as u32;
+        let compressed = zstd::stream::encode_all(&request_body[..], 0)
+            .or_http_err(StatusCode::INTERNAL_SERVER_ERROR, "encode zstd body")?;
+        drop(request_body);
+        self.touch(|i| i.total_bytes_to_send += request_total);
+
+        let exchange = async move {
+            let resp = request
+                .header(CONTENT_TYPE, "application/octet-stream")
+                .body(compressed)
+                .send()
+                .await?
+                .error_for_status()?;
+            // fetch has sent the whole body once headers come back
+            self.touch(|i| i.bytes_sent += request_total);
+            let response_total = resp
+                .headers()
+                .get(&ORIGINAL_SIZE)
+                .and_then(|v| v.to_str().ok())
+                .and_then(|v| v.parse::<u32>().ok())
+                .or_bad_request("missing original size")?;
+            // Progress counts compressed bytes against the compressed length when the
+            // server gives one, and the original size otherwise.
+            let wire_total = resp
+                .headers()
+                .get(CONTENT_LENGTH)
+                .and_then(|v| v.to_str().ok())
+                .and_then(|v| v.parse::<u32>().ok())
+                .unwrap_or(response_total);
+            self.touch(|i| i.total_bytes_to_receive += wire_total);
+            let mut body = Vec::with_capacity(wire_total as usize);
+            let mut stream = resp.bytes_stream();
+            while let Some(chunk) = stream.next().await {
+                let chunk = chunk.or_http_err(StatusCode::SEE_OTHER, "stream failure")?;
+                self.touch(|i| i.bytes_received += chunk.len() as u32);
+                body.extend_from_slice(&chunk);
+            }
+            let data = zstd::stream::decode_all(&body[..]).or_bad_request("decode zstd body")?;
+            Ok::<_, HttpError>(data)
+        };
+        let exchange = Box::pin(exchange);
+        let stall = Box::pin(self.timeout(stall_duration));
+        match select(exchange, stall).await {
+            Either::Left((data, _)) => data,
+            Either::Right(_) => Err(HttpError {
+                code: StatusCode::REQUEST_TIMEOUT,
+                context: "timeout monitor".into(),
+                source: None,
+            }),
+        }
+    }
+}
+
+#[derive(Debug)]
+pub struct IoMonitorInner {
+    last_activity: Instant,
+    pub bytes_sent: u32,
+    pub total_bytes_to_send: u32,
+    pub bytes_received: u32,
+    pub total_bytes_to_receive: u32,
+}
