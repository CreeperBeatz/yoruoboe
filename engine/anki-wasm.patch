index 0000000..6540f3d
--- /dev/null
+++ b/rslib/src/backend/sync_wasm.rs
@@ -0,0 +1,324 @@
+// Copyright: Ankitects Pty Ltd and contributors
+// License: GNU AGPL, version 3 or later; http://www.gnu.org/licenses/agpl.html
+
+//! Syncing in the browser. sync.rs blocks a thread on each network call; here
+//! the same steps are async functions the wasm crate awaits, and media syncs as
+//! a local task. The blocking entry points of the sync service fail, pointing to
+//! these.
+
+use std::sync::Arc;
+use std::sync::Mutex;
+
+use anki_proto::sync::sync_status_response::Required;
+use anki_proto::sync::MediaSyncStatusResponse;
+use futures::future::AbortHandle;
+use futures::future::AbortRegistration;
+use futures::future::Abortable;
+
+use super::sync::status_response_from_required;
+use super::Backend;
+use crate::prelude::*;
+use crate::services::BackendCollectionService;
+use crate::sync::collection::normal::SyncActionRequired;
+use crate::sync::collection::normal::SyncOutput;
+use crate::sync::collection::progress::sync_abort;
+use crate::sync::collection::status::online_sync_status_check;
+use crate::sync::http_client::HttpSyncClient;
+use crate::sync::login::sync_login;
+use crate::sync::login::SyncAuth;
+
+fn needs_async<T>() -> Result<T> {
+    invalid_input!("in the browser, sync calls go through the async API")
+}
+
+impl Backend {
+    fn sync_abort_handle(
+        &self,
+    ) -> (
+        scopeguard::ScopeGuard<Backend, impl FnOnce(Backend)>,
+        AbortRegistration,
+    ) {
+        let (abort_handle, abort_reg) = AbortHandle::new_pair();
+        self.sync_abort.lock().unwrap().replace(abort_handle);
+        let guard = scopeguard::guard(self.clone(), |backend| {
+            backend.sync_abort.lock().unwrap().take();
+        });
+        (guard, abort_reg)
+    }
+
+    pub(super) fn sync_media_in_background(
+        &self,
+        auth: SyncAuth,
+        server_usn: Option<Usn>,
+    ) -> Result<()> {
+        let mut task = self.media_sync_task.lock().unwrap();
+        if let Some(slot) = &*task {
+            if slot.lock().unwrap().is_none() {
+                // already running
+                return Ok(());
+            }
+        }
+        let (abort_handle, abort_reg) = AbortHandle::new_pair();
+        self.state.lock().unwrap().sync.media_sync_abort = Some(abort_handle);
+        let slot = Arc::new(Mutex::new(None));
+        *task = Some(slot.clone());
+        drop(task);
+        let backend = self.clone();
+        wasm_bindgen_futures::spawn_local(async move {
+            let result = backend.sync_media_async(auth, server_usn, abort_reg).await;
+            *slot.lock().unwrap() = Some(result);
+        });
+        Ok(())
+    }
+
+    async fn sync_media_async(
+        &self,
+        auth: SyncAuth,
+        server_usn: Option<Usn>,
+        abort_reg: AbortRegistration,
+    ) -> Result<()> {
+        let _clear_abort_handle = scopeguard::guard(self.clone(), |backend| {
+            backend.state.lock().unwrap().sync.media_sync_abort.take();
+        });
+        let (mgr, progress) = {
+            let mut col = self.col.lock().unwrap();
+            let col = col.as_mut().ok_or(AnkiError::CollectionNotOpen)?;
+            (col.media()?, col.new_progress_handler())
+        };
+        let sync_fut = mgr.sync_media(progress, auth, self.web_client(), server_usn);
+        match Abortable::new(sync_fut, abort_reg).await {
+            Ok(sync_result) => sync_result,
+            Err(_) => Err(AnkiError::Interrupted),
+        }
+    }
+
+    /// True if active. Will throw if terminated with error.
+    pub(super) fn get_media_sync_status(&self) -> Result<MediaSyncStatusResponse> {
+        let mut task = self.media_sync_task.lock().unwrap();
+        let active = match &*task {
+            Some(slot) => {
+                let finished = slot.lock().unwrap().take();
+                match finished {
+                    None => true,
+                    Some(result) => {
+                        task.take();
+                        result?;
+                        false
+                    }
+                }
+            }
+            None => false,
+        };
+        drop(task);
+        let progress = self.latest_progress()?;
+        let progress = if let Some(anki_proto::collection::progress::Value::MediaSync(progress)) =
+            progress.value
+        {
+            Some(progress)
+        } else {
+            None
+        };
+        Ok(MediaSyncStatusResponse { active, progress })
+    }
+
+    /// The browser can't wait here: this asks the media sync to stop, and it
+    /// stops the next time it gets to run.
+    pub(super) fn abort_media_sync_and_wait(&self) {
+        let guard = self.state.lock().unwrap();
+        if let Some(handle) = &guard.sync.media_sync_abort {
+            handle.abort();
+            self.progress_state.lock().unwrap().want_abort = true;
+        }
+    }
+
+    pub(super) fn sync_login_inner(
+        &self,
+        _input: anki_proto::sync::SyncLoginRequest,
+    ) -> Result<anki_proto::sync::SyncAuth> {
+        needs_async()
+    }
+
+    pub(super) fn sync_status_inner(
+        &self,
+        input: anki_proto::sync::SyncAuth,
+    ) -> Result<anki_proto::sync::SyncStatusResponse> {
+        match self.sync_status_without_network(&input)? {
+            Some(status) => Ok(status),
+            None => needs_async(),
+        }
+    }
+
+    pub(super) fn sync_collection_inner(
+        &self,
+        _input: anki_proto::sync::SyncCollectionRequest,
+    ) -> Result<anki_proto::sync::SyncCollectionResponse> {
+        needs_async()
+    }
+
+    pub(super) fn full_sync_inner(
+        &self,
+        _input: anki_proto::sync::SyncAuth,
+        _server_usn: Option<Usn>,
+        _upload: bool,
+    ) -> Result<()> {
+        needs_async()
+    }
+
+    /// The status if it can be told without asking the server.
+    fn sync_status_without_network(
+        &self,
+        _input: &anki_proto::sync::SyncAuth,
+    ) -> Result<Option<anki_proto::sync::SyncStatusResponse>> {
+        let req = self.with_col(|col| col.sync_status_offline())?;
+        if req != Required::NoChanges {
+            return Ok(Some(status_response_from_required(req)));
+        }
+        let guard = self.state.lock().unwrap();
+        if guard.sync.remote_sync_status.last_check.elapsed_secs() < 300 {
+            return Ok(Some(status_response_from_required(
+                guard.sync.remote_sync_status.last_response,
+            )));
+        }
+        Ok(None)
+    }
+
+    // ---- what the wasm crate awaits -----------------------------------------------
+
+    pub async fn sync_login_async(
+        &self,
+        input: anki_proto::sync::SyncLoginRequest,
+    ) -> Result<anki_proto::sync::SyncAuth> {
+        let (_guard, abort_reg) = self.sync_abort_handle();
+        let sync_fut = sync_login(
+            input.username,
+            input.password,
+            input.endpoint.clone(),
+            self.web_client(),
+        );
+        let ret = match Abortable::new(sync_fut, abort_reg).await {
+            Ok(sync_result) => sync_result,
+            Err(_) => Err(AnkiError::Interrupted),
+        };
+        ret.map(|a| anki_proto::sync::SyncAuth {
+            hkey: a.hkey,
+            endpoint: input.endpoint,
+            io_timeout_secs: None,
+        })
+    }
+
+    pub async fn sync_status_async(
+        &self,
+        input: anki_proto::sync::SyncAuth,
+    ) -> Result<anki_proto::sync::SyncStatusResponse> {
+        if let Some(status) = self.sync_status_without_network(&input)? {
+            return Ok(status);
+        }
+        let auth: SyncAuth = input.try_into()?;
+        let time_at_check_begin = TimestampSecs::now();
+        let local = self.with_col(|col| col.sync_meta())?;
+        let mut client = HttpSyncClient::new(auth, self.web_client());
+        let state = online_sync_status_check(local, &mut client).await?;
+        {
+            let mut guard = self.state.lock().unwrap();
+            if guard.sync.remote_sync_status.last_check < time_at_check_begin {
+                guard.sync.remote_sync_status.last_check = time_at_check_begin;
+                guard.sync.remote_sync_status.last_response = state.required.into();
+            }
+        }
+        Ok(state.into())
+    }
+
+    /// Holds the collection for the whole sync: the caller must not make other
+    /// collection calls until it finishes.
+    pub async fn sync_collection_async(
+        &self,
+        input: anki_proto::sync::SyncCollectionRequest,
+    ) -> Result<anki_proto::sync::SyncCollectionResponse> {
+        let auth: SyncAuth = input.auth.or_invalid("missing auth")?.try_into()?;
+        let (_guard, abort_reg) = self.sync_abort_handle();
+        let client = self.web_client();
+        let auth2 = auth.clone();
+
+        let ret = {
+            let mut guard = self.col.lock().unwrap();
+            let col = guard.as_mut().ok_or(AnkiError::CollectionNotOpen)?;
+            let sync_fut = col.normal_sync(auth.clone(), client.clone());
+            match Abortable::new(sync_fut, abort_reg).await {
+                Ok(sync_result) => sync_result,
+                Err(_) => {
+                    // if the user aborted, we'll need to clean up the transaction
+                    col.storage.rollback_trx()?;
+                    // and tell the server to clean up
+                    wasm_bindgen_futures::spawn_local(async move {
+                        let _ = sync_abort(auth, client).await;
+                    });
+                    Err(AnkiError::Interrupted)
+                }
+            }
+        };
+
+        let output: SyncOutput = ret?;
+
+        if input.sync_media
+            && !matches!(output.required, SyncActionRequired::FullSyncRequired { .. })
+        {
+            self.sync_media_in_background(auth2, Some(output.server_media_usn))?;
+        }
+
+        self.state
+            .lock()
+            .unwrap()
+            .sync
+            .remote_sync_status
+            .update(output.required.into());
+        Ok(output.into())
+    }
+
+    pub async fn full_upload_or_download_async(
+        &self,
+        input: anki_proto::sync::FullUploadOrDownloadRequest,
+    ) -> Result<()> {
+        let auth: SyncAuth = input.auth.or_invalid("missing auth")?.try_into()?;
+        let server_usn = input.server_usn.map(Usn);
+        let auth2 = auth.clone();
+        self.abort_media_sync_and_wait();
+
+        let mut col = self.col.lock().unwrap();
+        let col_inner = col.take().ok_or(AnkiError::CollectionNotOpen)?;
+        let (_guard, abort_reg) = self.sync_abort_handle();
+        let mut builder = col_inner.as_builder();
+
+        let result = if input.upload {
+            let sync_fut = col_inner.full_upload(auth, self.web_client());
+            Abortable::new(sync_fut, abort_reg).await
+        } else {
+            let sync_fut = col_inner.full_download(auth, self.web_client());
+            Abortable::new(sync_fut, abort_reg).await
+        };
+
+        // ensure re-opened regardless of outcome
+        col.replace(builder.build()?);
+        drop(col);
+
+        let result = match result {
+            Ok(sync_result) => {
+                if sync_result.is_ok() {
+                    self.state
+                        .lock()
+                        .unwrap()
+                        .sync
+                        .remote_sync_status
+                        .update(Required::NoChanges);
+                }
+                sync_result
+            }
+            Err(_) => Err(AnkiError::Interrupted),
+        };
+
+        if result.is_ok() && server_usn.is_some() {
+            self.sync_media_in_background(auth2, server_usn)?;
+        }
+
+        result
+    }
+}
