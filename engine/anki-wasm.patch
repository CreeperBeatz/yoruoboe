new file mode 100644
index 0000000..ac2bed8
--- /dev/null
+++ b/rslib/src/wasm.rs
@@ -0,0 +1,48 @@
+// Copyright: Ankitects Pty Ltd and contributors
+// License: GNU AGPL, version 3 or later; http://www.gnu.org/licenses/agpl.html
+
+//! What the browser build needs in place of threads and tokio's timers.
+//!
+//! wasm32-unknown-unknown without the atomics feature has a single thread, so a
+//! future that holds JS values can be treated as Send: nothing can move it to
+//! another thread.
+
+use std::future::Future;
+use std::pin::Pin;
+use std::task::Context;
+use std::task::Poll;
+use std::time::Duration;
+
+use wasm_bindgen::JsCast;
+use wasm_bindgen::JsValue;
+
+pub struct AssertSend<F>(pub F);
+
+// SAFETY: see the module docs; this build has one thread.
+unsafe impl<F> Send for AssertSend<F> {}
+unsafe impl<F> Sync for AssertSend<F> {}
+
+impl<F: Future> Future for AssertSend<F> {
+    type Output = F::Output;
+
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        // SAFETY: structural pinning of the only field.
+        unsafe { self.map_unchecked_mut(|s| &mut s.0) }.poll(cx)
+    }
+}
+
+/// Resolves after `duration`, using the global setTimeout (window or worker).
+pub async fn sleep(duration: Duration) {
+    let promise = js_sys::Promise::new(&mut |resolve, _reject| {
+        let global = js_sys::global();
+        let set_timeout: js_sys::Function = js_sys::Reflect::get(&global, &"setTimeout".into())
+            .expect("setTimeout")
+            .unchecked_into();
+        let _ = set_timeout.call2(
+            &global,
+            &resolve,
+            &JsValue::from_f64(duration.as_millis() as f64),
+        );
+    });
+    let _ = AssertSend(wasm_bindgen_futures::JsFuture::from(promise)).await;
+}
